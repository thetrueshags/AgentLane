#!/usr/bin/env python3
"""Install a local wheel in an isolated environment and smoke-test an unrelated project."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import venv

if len(sys.argv) != 2:
    raise SystemExit("Usage: python tools/check-package PATH_TO_WHEEL")
wheel = Path(sys.argv[1]).resolve(strict=True)
with tempfile.TemporaryDirectory(prefix="agentlane-wheel-") as temporary:
    root = Path(temporary)
    environment = root / "env"
    venv.EnvBuilder(with_pip=True).create(environment)
    bindir = environment / ("Scripts" if os.name == "nt" else "bin")
    python = bindir / ("python.exe" if os.name == "nt" else "python")
    cli = bindir / ("agentlane.exe" if os.name == "nt" else "agentlane")
    env = dict(os.environ, PATH=str(bindir) + os.pathsep + os.environ.get("PATH", ""),
               GIT_AUTHOR_NAME="Package check", GIT_AUTHOR_EMAIL="check@example.invalid",
               GIT_COMMITTER_NAME="Package check", GIT_COMMITTER_EMAIL="check@example.invalid")
    env.pop("PYTHONPATH", None)
    env.pop("AGENTLANE_LOCK_HELD", None)

    def run(command, cwd=root, expected=0):
        p = subprocess.run([str(x) for x in command], cwd=cwd, env=env, text=True, capture_output=True)
        if p.returncode != expected:
            raise RuntimeError("Command failed: %s\n%s\n%s" % (command, p.stdout, p.stderr))
        return p.stdout

    run([python, "-m", "pip", "install", "--no-index", "--no-deps", wheel])
    assert "AgentLane" in run([cli, "--version"])
    assert "doctor" in run([cli, "--help"])
    assert not json.loads(run([cli, "doctor", "--json"], expected=1))["ok"]
    project = root / "project"
    remote = root / "origin.git"
    run(["git", "init", "--bare", "-b", "main", remote])
    run(["git", "clone", remote, project])
    (project / "README.md").write_text("# Wheel smoke check\n", encoding="utf-8")
    run(["git", "add", "README.md"], project)
    run(["git", "commit", "-m", "Initial project"], project)
    run(["git", "push", "origin", "main"], project)
    installed = json.loads(run([cli, "install", "--project", "--agent", "codex", "--json"], project))
    assert ".harness/gate/code.sh" in installed["added"]
    assert (project / ".harness/LICENSE").is_file()
    run([cli, "init"], project)
    run([cli, "join", "--name", "alice", "--agent", "codex"], project)
    task = json.loads(run([cli, "add", "Set up project", "--paths", ".harness/**", "AGENTS.md", ".codex/config.toml", "--json"], project))
    run([cli, "take", task["id"]], project)
    run(["git", "add", ".harness", "AGENTS.md", ".codex/config.toml"], project)
    run(["git", "commit", "-m", "Configure AgentLane"], project)
    landed = json.loads(run([cli, "done", task["id"], "--json"], project))
    assert landed["task"]["status"] == "done"
    run([cli, "install", "--project", "--agent", "codex"], project)
    assert "agentlane" in (project / ".codex/config.toml").read_text()
print("Wheel installation, CLI and standalone-project landing passed.")

#!/usr/bin/env python3
"""Compatibility launcher for AgentLane's stdio MCP tools."""
import os
import sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, root)
os.environ.setdefault("BOARD_REPO_ROOT", root)
# Child commands can run the source checkout before it has been installed.
os.environ["PYTHONPATH"] = root + os.pathsep + os.environ.get("PYTHONPATH", "")
from agentlane.mcp import main
if __name__ == "__main__":
    main()
